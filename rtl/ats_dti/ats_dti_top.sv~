module dti_ats_top
  import rv_iommu_dti_ats_pkg::*;
#(
  parameter DATA_WIDTH = 160,
  parameter typer axis_req_t = logic,
  parameter typer axis_rsp_t = logic
) (
  input  logic      clk_i,
  input  logic      rst_ni,

  // AXI4-Stream Master Interface
  output axis_req_t axis_req_up_o,
  input  axis_rsp_t axis_rsp_up_i,

  // AXI4-Stream Slave Interface
  input  axis_req_t axis_req_dn_i,
  output axis_rsp_t axis_rsp_dn_o

  // TBD ...
  // TBD ...
  // TBD ...
  // TBD ...
);

/////////////////////////////
//// Parameters and Defs ////
/////////////////////////////

   logic [DATA_WIDTH-1:0] dn_msg, up_msg;
   logic                  up_msg_valid, up_msg_ready;
   logic                  dn_msg_valid, dn_msg_ready;

/////////////////////////
//// Transport layer ////
/////////////////////////

   //Downstream Logic

   typedef enum logic {
    IDLE,
    SENDING
   } state_e;

   state_e current_state, next_state;

   dti_ats_axis_dn_fsm #(
     .DATA_WIDTH ( DATA_WIDTH ),
     .axis_req_t ( axis_req_t ),
     .axis_rsp_t ( axis_rsp_t )
   ) downstream_fsm (
     .clk_i          ( clk_i         ),
     .rst_ni         ( rst_ni        ),
     .axis_req_dn_i  ( axis_req_dn_i ),
     .axis_rsp_dn_o  ( axis_rsp_dn_o ),
     .dn_msg_o       ( dn_msg        ),
     .dn_msg_valid_o ( dn_msg_valid  ),
     .dn_msg_ready_i ( dn_msg_ready  )
   );

   always_comb begin : downstream_msg_fsm

   end

   //Upstream Logic

   dti_ats_axis_up_fsm #(
     .DATA_WIDTH ( DATA_WIDTH ),
     .axis_req_t ( axis_req_t ),
     .axis_rsp_t ( axis_rsp_t )
   ) upstream_fsm (
     .clk_i          ( clk_i         ),
     .rst_ni         ( rst_ni        ),
     .axis_req_up_o  ( axis_req_up_o ),
     .axis_rsp_up_i  ( axis_rsp_up_i ),
     .up_msg_i       ( up_msg        ),
     .up_msg_valid_i ( up_msg_valid  ),
     .up_msg_ready_o ( up_msg_ready  )
   );

///////////////////////////////////
//// Downstream Message Decode ////
///////////////////////////////////

 endmodule
